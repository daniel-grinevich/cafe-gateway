# cafe-gateway configuration. Only the first block is required in a cluster; everything else has a default.

# --- required (secrets; Infisical /cafe-gateway) ---
DATABASE_URL=postgresql://cafe_gateway:<POSTGRES_PASSWORD>@cafe-gateway-postgres:5432/cafe_gateway
OPEN_ROUTER_KEY=sk-or-...
# Bearer token for /v1/admin/* (openssl rand -hex 32). Unset = admin API off.
BARISTA_ADMIN_TOKEN=
# Postgres StatefulSet only.
POSTGRES_PASSWORD=

# --- per deployment ---
# barista (POST /v1/decide, bar_ keys) or grinder (POST /v1/embed, grd_ keys).
BARISTA_SERVICE=barista

# --- config (ConfigMap cafe-gateway-config) ---
# Model allow-lists, comma-separated; the first is the default.
BARISTA_MODELS=perplexity/pplx-decider-flash-v1.2
GRINDER_MODELS=qwen/qwen3-embedding-8b
# Global monthly caps (USD, UTC calendar month). Requests that would cross the cap get 402. 0 blocks all calls.
BARISTA_MONTHLY_CAP_USD=10
GRINDER_MONTHLY_CAP_USD=10
# Forced onto every OpenRouter request as provider.data_collection. deny = only providers that don't store/train.
OPENROUTER_DATA_COLLECTION=deny
# Store request bodies on usage rows (debugging only).
BARISTA_DEBUG_STORE_BODIES=false

# --- optional, with defaults ---
# BARISTA_ADDR=:8000
# BARISTA_INTERNAL_METRICS_ADDR=:9090 # internal-only /metrics with per-key labels; "off" disables. Never expose it.
# BARISTA_ALLOWED_HOSTS=            # comma-separated hostnames; empty = any. /health, /ready, /metrics always answer.
# DEFAULT_RPM=30
# DEFAULT_MAX_TOKENS_PER_REQUEST=8000
# DEFAULT_MONTHLY_BUDGET_USD=1
# DECIDE_OUTPUT_TOKEN_ALLOWANCE=512 # output tokens assumed when reserving a decision's cost
# FALLBACK_PRICE_PER_MTOK_USD=1     # used when neither usage.cost nor the catalogue has a price
# PRICING_TTL_S=21600
# RESERVATION_TTL_S=600             # how long an unsettled reservation (crashed pod) counts against caps
# MAX_EMBED_INPUTS=256
# MAX_BODY_BYTES=4194304
# UPSTREAM_CONNECT_TIMEOUT_S=5
# UPSTREAM_READ_TIMEOUT_S=60
# UPSTREAM_MAX_RETRIES=2
# UPSTREAM_BACKOFF_BASE_S=0.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# OPENROUTER_APP_URL=https://github.com/daniel-grinevich/cafe-gateway
# OPENROUTER_APP_TITLE=cafe-gateway
# LOG_LEVEL=info
